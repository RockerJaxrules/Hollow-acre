{
  "name": "hollow-acre",
  "productName": "Hollow Acre",
  "version": "1.1.0",
  "description": "A psychological-horror farming game.",
  "author": {
    "name": "Hollow Acre",
    "email": "hollowacre@users.noreply.github.com"
  },
  "homepage": "https://github.com/RockerJaxrules/Hollow-acre",
  "main": "main.js",
  "scripts": {
    "copy": "node copy-game.js",
    "start": "node copy-game.js && electron .",
    "dist": "node copy-game.js && electron-builder --publish never",
    "dist:win": "node copy-game.js && electron-builder --win --publish never",
    "dist:mac": "node copy-game.js && electron-builder --mac --publish never",
    "dist:linux": "node copy-game.js && electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.hollowacre.game",
    "productName": "Hollow Acre",
    "copyright": "Hollow Acre",
    "files": [
      "main.js",
      "preload.js",
      "shell/**/*",
      "game/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "RockerJaxrules",
        "repo": "Hollow-acre",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Hollow Acre",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "HollowAcre-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "HollowAcre-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "HollowAcre-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "Hollow Acre",
      "synopsis": "A psychological-horror farming game.",
      "executableName": "hollow-acre"
    },
    "appImage": {
      "artifactName": "HollowAcre-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "HollowAcre_${version}_${arch}.deb"
    },
    "afterPack": "build/adhoc-sign.js",
    "dmg": {
      "title": "Hollow Acre",
      "artifactName": "HollowAcre-${version}-mac-${arch}.${ext}"
    }
  }
}
